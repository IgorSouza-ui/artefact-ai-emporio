# ==============================================================================
# Empório da Música - AI Customer Support Agent Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Choose one of the providers below. Gemini is recommended and configured as default.

# 1. Google Gemini (Recommended)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI (Optional alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Agent Settings
AGENT_TEMPERATURE=0.3
AGENT_MAX_TURNS=5
DEBUG_TOOLS=false
